#!/usr/bin/env python3
import pygame
import pyaudio
import wave
import requests
import threading
import time
import os
import tempfile
import subprocess
from pathlib import Path

class AvatarPipeline:
    def __init__(self):
        # Service URLs
        self.stt_url = "http://localhost:9000"
        self.llm_url = "http://localhost:8000/v1/chat/completions"
        self.tts_url = "http://localhost:5002/synthesize"

        # Audio settings
        self.audio_format = pyaudio.paInt16
        self.channels = 1
        self.rate = 16000
        self.chunk = 1024
        self.audio_device = "plughw:2,0"

        # Display settings
        self.screen_width = 800
        self.screen_height = 600
        self.current_text = "Hello! Press SPACE to talk to me."
        self.is_listening = False
        self.is_speaking = False

        # Initialize components
        pygame.init()
        self.audio = pyaudio.PyAudio()
        self.screen = pygame.display.set_mode((self.screen_width, self.screen_height))
        pygame.display.set_caption("AI Avatar")

        # Load avatar image
        self.avatar_image = None
        try:
            self.avatar_image = pygame.image.load("avatar.png")
            self.avatar_image = pygame.transform.scale(self.avatar_image, (self.screen_width, self.screen_height))
        except:
            print("⚠️  No avatar.png found, using solid color background")

        # Font
        self.font = pygame.font.SysFont(None, 36)

    def record_audio(self, duration=3):
        """Record audio from microphone"""
        print(f"🎤 Recording {duration}s...")

        try:
            stream = self.audio.open(
                format=self.audio_format,
                channels=self.channels,
                rate=self.rate,
                input=True,
                input_device_index=2,  # ReSpeaker
                frames_per_buffer=self.chunk
            )

            frames = []
            for _ in range(0, int(self.rate / self.chunk * duration)):
                data = stream.read(self.chunk)
                frames.append(data)

            stream.stop_stream()
            stream.close()

            # Save to file
            with wave.open('recording.wav', 'wb') as wf:
                wf.setnchannels(self.channels)
                wf.setsampwidth(self.audio.get_sample_size(self.audio_format))
                wf.setframerate(self.rate)
                wf.writeframes(b''.join(frames))

            return 'recording.wav'

        except Exception as e:
            print(f"❌ Audio recording error: {e}")
            return None

    def transcribe_audio(self, audio_file):
        """Send audio to STT service"""
        print("📝 Transcribing audio...")

        try:
            with open(audio_file, 'rb') as f:
                files = {'audio_file': ('audio.wav', f, 'audio/wav')}
                response = requests.post(
                    f"{self.stt_url}/asr",
                    files=files,
                    params={
                        'encode': 'true',
                        'task': 'transcribe',
                        'language': 'en',
                        'vad_filter': 'true'
                    },
                    timeout=10
                )

            if response.status_code == 200:
                result = response.json()
                text = result.get('text', '').strip()
                if text:
                    print(f"📝 You said: '{text}'")
                    return text
                else:
                    return "I didn't catch that clearly."
            else:
                print(f"❌ STT Error: {response.status_code}")
                return "Sorry, I couldn't process your audio."

        except Exception as e:
            print(f"❌ STT Exception: {e}")
            return "Audio processing failed."

    def generate_response(self, user_text):
        """Send text to LLM for response generation"""
        if not user_text:
            return "I didn't hear anything. Could you please try again?"

        print("🤖 Generating AI response...")

        try:
            payload = {
                "model": "Qwen/Qwen2.5-3B-Instruct",
                "messages": [
                    {
                        "role": "system",
                        "content": "You are a friendly AI avatar assistant. Keep responses conversational and under 50 words. Be warm and engaging."
                    },
                    {
                        "role": "user",
                        "content": user_text
                    }
                ],
                "max_tokens": 100,
                "temperature": 0.7
            }

            response = requests.post(self.llm_url, json=payload, timeout=15)

            if response.status_code == 200:
                result = response.json()
                ai_text = result['choices'][0]['message']['content'].strip()
                print(f"🤖 AI says: '{ai_text}'")
                return ai_text
            else:
                print(f"❌ LLM Error: {response.status_code}")
                return "I'm having trouble connecting to my brain right now."

        except Exception as e:
            print(f"❌ LLM Exception: {e}")
            return "Sorry, I'm experiencing some technical difficulties."

    def synthesize_speech(self, text):
        """Send text to TTS service"""
        print("🗣️ Synthesizing speech...")

        try:
            payload = {
                "text": text,
                "voice": "af_heart",
                "speed": 1.0
            }

            response = requests.post(f"{self.tts_url}/synthesize", json=payload, timeout=10)

            if response.status_code == 200:
                result = response.json()
                audio_b64 = result['audio']

                # Decode and save audio
                import base64
                audio_data = base64.b64decode(audio_b64)
                with open('response.wav', 'wb') as f:
                    f.write(audio_data)

                return 'response.wav'
            else:
                print(f"❌ TTS Error: {response.status_code}")
                return None

        except Exception as e:
            print(f"❌ TTS Exception: {e}")
            return None

    def play_audio(self, audio_file):
        """Play audio through speakers"""
        if not audio_file or not os.path.exists(audio_file):
            print("❌ No audio file to play")
            return

        print("🔊 Playing audio...")

        try:
            subprocess.run([
                "aplay", "-D", "plughw:1,0", audio_file
            ], capture_output=True, timeout=10)
        except Exception as e:
            print(f"❌ Audio playback error: {e}")

    def render_avatar(self):
        """Render the avatar display"""
        # Background
        self.screen.fill((20, 20, 30))

        # Avatar image
        if self.avatar_image:
            self.screen.blit(self.avatar_image, (0, 0))
        else:
            # Solid color background if no image
            pygame.draw.rect(self.screen, (60, 60, 80), (0, 0, self.screen_width, self.screen_height))

        # Status indicator
        if self.is_listening:
            status_color = (0, 255, 0)  # Green
            status_text = "🎤 Listening..."
        elif self.is_speaking:
            status_color = (255, 165, 0)  # Orange
            status_text = "🗣️ Speaking..."
        else:
            status_color = (255, 255, 255)  # White
            status_text = "Press SPACE to talk"

        # Status text
        status_surface = self.font.render(status_text, True, status_color)
        self.screen.blit(status_surface, (10, 10))

        # Current conversation text
        if self.current_text:
            # Split text into lines if too long
            words = self.current_text.split()
            lines = []
            current_line = ""
            for word in words:
                if len(current_line + word) < 40:
                    current_line += word + " "
                else:
                    lines.append(current_line.strip())
                    current_line = word + " "
            lines.append(current_line.strip())

            for i, line in enumerate(lines[-3:]):  # Show last 3 lines
                text_surface = self.font.render(line, True, (255, 255, 255))
                self.screen.blit(text_surface, (10, 50 + i * 40))

        pygame.display.flip()

    def handle_conversation(self):
        """Handle a complete conversation turn"""
        self.is_listening = True
        self.current_text = "Listening..."
        self.render_avatar()

        # Record audio
        audio_file = self.record_audio(3)

        if audio_file:
            # Transcribe
            user_text = self.transcribe_audio(audio_file)
            self.current_text = f"You: {user_text}"
            self.is_listening = False
            self.render_avatar()

            if user_text and "didn't catch" not in user_text.lower():
                # Generate AI response
                ai_response = self.generate_response(user_text)
                self.current_text = f"AI: {ai_response}"
                self.render_avatar()

                # Synthesize and play speech
                self.is_speaking = True
                self.render_avatar()

                audio_file = self.synthesize_speech(ai_response)
                if audio_file:
                    self.play_audio(audio_file)

                self.is_speaking = False
            else:
                self.current_text = "Ready to talk!"
        else:
            self.current_text = "Recording failed!"
            self.is_listening = False

        self.render_avatar()

    def run(self):
        """Main avatar loop"""
        print("🎭 AI Avatar Started!")
        print("Controls:")
        print("  SPACE: Start conversation")
        print("  ESC: Exit")
        print()

        running = True
        while running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        running = False
                    elif event.key == pygame.K_SPACE and not self.is_listening and not self.is_speaking:
                        # Start conversation in background thread
                        threading.Thread(target=self.handle_conversation).start()

            self.render_avatar()
            time.sleep(0.1)  # Small delay to prevent excessive CPU usage

        pygame.quit()
        self.audio.terminate()
        print("👋 Avatar shutdown complete")

if __name__ == "__main__":
    avatar = AvatarPipeline()
    avatar.run()