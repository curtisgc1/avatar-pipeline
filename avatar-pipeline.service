[Unit]
Description=Avatar Pipeline Service
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=curtis
WorkingDirectory=/home/curtis/avatar-pipeline
Environment=PYTHONPATH=/home/curtis/avatar-pipeline
ExecStart=/usr/bin/python3 /home/curtis/avatar-pipeline/main_pipeline.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
